close all;
%% Parameters
% Smoothing factor of moving average filter used on energy plot
smoothing = 10;


% Cutoff threshold in dB for final note end
drop = 30;
%% Code


[y, Fs] = audioread("test_audio/20_notes.mp3");

% Stretch audio makes the audio sample longer without changing sampling
% rate requires audio toolbox so not used for now.
%y = stretchAudio(y, 0.75);
if size(y, 2) > 1
    y = mean(y, 2);   
end 
windowLength = 1024;

overlap = round(0.8*windowLength);
nfft = 8192;
window = hann(windowLength);

[S, F, T] = stft(y, Fs, ...
    'Window', window, ...
    'OverlapLength', overlap, ...
    'FFTLength', nfft, ...
    'FrequencyRange','onesided');

P = abs(S);
P_dB = 20*log10(P + eps);

plot_spectogram(T, F, P_dB);
energy_dB = 20*log10(sum(P.^2, 1) + eps);
energy_smooth = energy_dB;

energy_smooth(energy_smooth < 0) = 0;
energy_ma = movmean(energy_smooth, smoothing);
figure;
plot(T, energy_ma);

[max, min] = find_note_edges(energy_smooth);
[min, last_note_closed] = close_last_note(max, min, energy_ma, drop);

hold on;
plot(T(max(1,:)), max(2,:), 'ro');
plot(T(min(1,:)), min(2,:), 'bo');
grid on;
xlabel('Time (s)');
ylabel('Energy (dB)');
title('Energy with Local Maxima and Minima');
hold off;
num_notes = size(max,2);
notes = zeros(num_notes);
if num_notes == 0
    disp('No notes found.');
end
max_time = T(max(1,:));
min_time = T(min(1,:));

max_sample = round(max_time*Fs)+1;
min_sample = round(min_time*Fs)+1;

for i = 1:num_notes

    freq = find_frequency(max_sample(i), min_sample(i), y, Fs);
    notes(i) = freq;

end

function freq = find_frequency(note_start, note_end, signal, Fs)
    note = signal(note_start: note_end);
    note = note - mean(note);
    Y = fft(note);

    N = length(note);
    P = abs(Y/N);
    P = P(1:floor(N/2)+1);
    fft_threshold = 0.1 * max(P);

    if length(P) > 2
        P(2:end-1) = 2*P(2:end-1);
    end
    f = Fs*(0:floor(N/2))/N;

    P(1) = 0;
    
    [peak, loc] = findpeaks(P);
    valid_peaks = find(peak >= fft_threshold);
    if isempty(valid_peaks)
        freq = NaN;
        disp('No peak found');
    else
        first_peak = valid_peaks(1);
        freq = f(loc(first_peak));
        [name, ~] = freq2note(freq);
        disp(name);
    end
end


% finds the note edges
% looks for local maxes and mins and determines where note edges are
function [max_fixed, min_fixed] = find_note_edges(x)
    min_peak_size = 5;
    smoothWindow = 10;
    min_distance = 20;
    xSmooth = movmean(x, smoothWindow);

    % find max vals
    [max_val_i, max_loc_i, ~, max_prom] = findpeaks(xSmooth, ...
        'MinPeakProminence',min_peak_size);
    max_data = [max_loc_i; max_val_i; max_prom];

    % find min vals
    [min_val_i, min_loc_i, ~, min_prom] = findpeaks(-xSmooth, 'MinPeakProminence',min_peak_size);
    min_val_i = -min_val_i;
    min_data = [min_loc_i; min_val_i; min_prom];
    [max_fixed, min_fixed] = fix_extrema(max_data, min_data, min_distance);
end

function [max_fixed, min_fixed] = fix_extrema(max, min, min_distance)
    i = 1;
    while i < size(max,2)
        if max(1,i+1) - max(1,i) <= min_distance
            if max(3,i) >= max(3,i+1)
                
                max(:,i+1) = [];
            else
                max(:,i) = [];
                if i > 1
                    i = i-1;
                end
            end
        else
            i = i + 1;
        end    
    end
    i = 1;
    while i < size(min,2)
        if min(1,i+1) - min(1,i) <= min_distance
            if min(3,i) >= min(3,i+1)
                min(:,i+1) = [];
            else
                min(:,i) = [];

                if i > 1
                    i = i-1;
                end
            end
        else
            i = i + 1;
        end    
    end
    
    loc = [max(1,:), min(1,:)];
    val = [max(2,:), min(2,:)];
    type= [ones(size(max,2),1), -ones(size(max,2),1)];
    [loc, order] = sort(loc);
    val = val(order);
    type = type(order);
    i = 1;

    while i < length(type)
        if type(i) == type(i+1)
            loc(i+1) = [];
            val(i+1) = [];
            type(i+1) = [];
        else
            i = i+1;
        end
    end
    max_mask = type == 1;
    min_mask = type == -1;
    max_index = loc(max_mask);
    max_val = val(max_mask);
    min_index = loc(min_mask);
    min_val = val(min_mask);
    max_fixed = [max_index; max_val];
    min_fixed = [min_index; min_val];
end

% If the last note has no minimum after it, add one at the
% the last max where the energy has fallen drop below max
function [min, closed] = close_last_note(max, min, energy, drop)
    closed = false;
    if isempty(max) || size(min, 2) >= size(max, 2)
        return;   % every note already has an end
    end

    last_idx = max(1, end);
    cutoff   = max(2, end) - drop;
    rel = find(energy(last_idx:end) <= cutoff, 1, 'first');
    if isempty(rel)
        end_idx = numel(energy);
    else
        end_idx = last_idx + rel - 1;
    end

    min(:, end+1) = [end_idx; energy(end_idx)];
    closed = true;
end

% Plots the spectogram of the STFT
% took it out of the main code for clarity
function plot_spectogram(T, F, P_dB)
    figure;
    imagesc(T, F, P_dB); 
    axis xy;
    xlabel('Time (s)');
    ylabel('Frequency (Hz)');
    title('STFT Spectrogram');
    colorbar;
    ylabel(colorbar, 'Magnitude (dB)');
    colormap jet;
    ylim([0 1000]);
    clim([max(P_dB(:))-60 max(P_dB(:))]);
end


function [name, cents] = freq2note(f)
noteNames = {'C','C#','D','D#','E','F','F#','G','G#','A','A#','B'};

% Convert to the nearest Midi
% Make sure that the frequency coming in has a value
if isnan(f) || f <= 0
    name = 'N/A'
    cents = NaN;
    return;
end
% Look at where the detected frequency actually lies
midiExact = 69 + 12*log2(f/440);
% Find the nearest musical note
midi = round(midiExact);

noteIndex = mod(midi, 12);
octave = floor(midi/12) - 1;

% Validate the Midi range for piano
% Can modify these values based on what instruments we want our project to
% be valid for, as varies by instrument
if midi < 0 || midi > 127
    name = 'Not a valid note.';
    cents = NaN;
    return;
end

name = sprintf('%s%d', noteNames{noteIndex+1}, octave);
% Figure out how far the measured frequency of the exact frequency is from
% the nearest musical note
cents = 100*(midiExact - midi);
end
